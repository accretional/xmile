<?xml version="1.0" encoding="UTF-8"?>
<!-- docx.xsd — a partial vocabulary for the XML parts of a .docx package.

     This is the level-2 spec for the parts a real .docx normally carries:
     the WordprocessingML main document and its companions (styles, fontTable,
     settings, webSettings, numbering, headers/footers, foot/endnotes) plus the
     shared OOXML parts a Word package also includes (the DrawingML theme and the
     docProps core/extended properties). One compiled descriptor holds a message
     per part root, so the OPC layer routes each part to its type by root local
     name (w:styles -> styles, a:theme -> theme, cp:coreProperties ->
     coreProperties, …); a part whose root is not modeled is left untyped.

     It is deliberately partial: the format registry loads it with Open=true, so
     the projector types the modeled markup and tolerates everything else the
     formats define. That keeps a single self-contained file inside the supported
     XSD subset (element, complexType inline/named, sequence/choice, attribute,
     occurrence, simpleContent extension) while still giving real .docx parts
     meaningful typed structure.

     Local element names only: the projector matches by local name, so the w: / a:
     / cp: / dc: prefixes on real documents line up with these unprefixed
     declarations.

     Spec: ECMA-376 Part 1 / ISO-IEC 29500-1 — WordprocessingML (§17), DrawingML
     theme (§20), and the OPC/OOXML core + extended properties (ISO/IEC 29500-2
     §11, §15). See docs/REFERENCES.md. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Root: the main document part. -->
  <xs:element name="document">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="body" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Body: block-level content (paragraphs and tables), closed by sectPr. -->
  <xs:element name="body">
    <xs:complexType>
      <xs:sequence>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="p"/>
          <xs:element ref="tbl"/>
        </xs:choice>
        <xs:element ref="sectPr" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Paragraph: optional properties then runs. -->
  <xs:element name="p">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="pPr" minOccurs="0"/>
        <xs:element ref="r" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Paragraph properties: the common core. -->
  <xs:element name="pPr">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="pStyle" minOccurs="0"/>
        <xs:element ref="jc" minOccurs="0"/>
        <xs:element ref="spacing" minOccurs="0"/>
        <xs:element ref="ind" minOccurs="0"/>
        <xs:element ref="numPr" minOccurs="0"/>
        <xs:element ref="rPr" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="pStyle">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="jc">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="spacing">
    <xs:complexType>
      <xs:attribute name="before" type="xs:string"/>
      <xs:attribute name="after" type="xs:string"/>
      <xs:attribute name="line" type="xs:string"/>
      <xs:attribute name="lineRule" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="ind">
    <xs:complexType>
      <xs:attribute name="left" type="xs:string"/>
      <xs:attribute name="right" type="xs:string"/>
      <xs:attribute name="firstLine" type="xs:string"/>
      <xs:attribute name="hanging" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="numPr">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="ilvl" minOccurs="0"/>
        <xs:element ref="numId" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="ilvl">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="numId">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Run: optional properties then run content (text, breaks, tabs). -->
  <xs:element name="r">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="rPr" minOccurs="0"/>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="t"/>
          <xs:element ref="br"/>
          <xs:element ref="tab"/>
          <xs:element ref="cr"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Run properties: the common core. -->
  <xs:element name="rPr">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="rStyle" minOccurs="0"/>
        <xs:element ref="rFonts" minOccurs="0"/>
        <xs:element ref="b" minOccurs="0"/>
        <xs:element ref="i" minOccurs="0"/>
        <xs:element ref="u" minOccurs="0"/>
        <xs:element ref="color" minOccurs="0"/>
        <xs:element ref="sz" minOccurs="0"/>
        <xs:element ref="highlight" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="rStyle">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="rFonts">
    <xs:complexType>
      <xs:attribute name="ascii" type="xs:string"/>
      <xs:attribute name="hAnsi" type="xs:string"/>
      <xs:attribute name="cs" type="xs:string"/>
      <xs:attribute name="eastAsia" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="b">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="i">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="u">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="color">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="sz">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="highlight">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Text: character content plus the optional xml:space attribute. -->
  <xs:element name="t">
    <xs:complexType>
      <xs:simpleContent>
        <xs:extension base="xs:string">
          <xs:attribute name="space" type="xs:string"/>
        </xs:extension>
      </xs:simpleContent>
    </xs:complexType>
  </xs:element>

  <xs:element name="br">
    <xs:complexType>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="clear" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="tab">
    <xs:complexType/>
  </xs:element>

  <xs:element name="cr">
    <xs:complexType/>
  </xs:element>

  <!-- Table: optional properties and grid, then rows. -->
  <xs:element name="tbl">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tblPr" minOccurs="0"/>
        <xs:element ref="tblGrid" minOccurs="0"/>
        <xs:element ref="tr" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="tblPr">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tblStyle" minOccurs="0"/>
        <xs:element ref="tblW" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="tblStyle">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="tblW">
    <xs:complexType>
      <xs:attribute name="w" type="xs:string"/>
      <xs:attribute name="type" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="tblGrid">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="gridCol" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="gridCol">
    <xs:complexType>
      <xs:attribute name="w" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Table row: optional properties then cells. -->
  <xs:element name="tr">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="trPr" minOccurs="0"/>
        <xs:element ref="tc" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="trPr">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="trHeight" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="trHeight">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
      <xs:attribute name="hRule" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Table cell: optional properties then block content (paragraphs, tables). -->
  <xs:element name="tc">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tcPr" minOccurs="0"/>
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element ref="p"/>
          <xs:element ref="tbl"/>
        </xs:choice>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="tcPr">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="tcW" minOccurs="0"/>
        <xs:element ref="gridSpan" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="tcW">
    <xs:complexType>
      <xs:attribute name="w" type="xs:string"/>
      <xs:attribute name="type" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="gridSpan">
    <xs:complexType>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- Section properties: page size and margins. -->
  <xs:element name="sectPr">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="pgSz" minOccurs="0"/>
        <xs:element ref="pgMar" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="pgSz">
    <xs:complexType>
      <xs:attribute name="w" type="xs:string"/>
      <xs:attribute name="h" type="xs:string"/>
      <xs:attribute name="orient" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="pgMar">
    <xs:complexType>
      <xs:attribute name="top" type="xs:string"/>
      <xs:attribute name="right" type="xs:string"/>
      <xs:attribute name="bottom" type="xs:string"/>
      <xs:attribute name="left" type="xs:string"/>
      <xs:attribute name="header" type="xs:string"/>
      <xs:attribute name="footer" type="xs:string"/>
      <xs:attribute name="gutter" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- ================================================================= -->
  <!-- Companion parts. Each root below matches a part's root element by  -->
  <!-- local name; many reuse the body vocabulary above (pPr, rPr, p,     -->
  <!-- tbl). All partial + open: common markup typed, the rest tolerated. -->
  <!-- ================================================================= -->

  <!-- word/styles.xml (and stylesWithEffects.xml): <w:styles>. -->
  <xs:element name="styles">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="docDefaults" minOccurs="0"/>
        <xs:element ref="style" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="docDefaults">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="rPrDefault" minOccurs="0"/>
        <xs:element ref="pPrDefault" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="rPrDefault">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="rPr" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="pPrDefault">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="pPr" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- A style definition: properties plus the paragraph/run defaults it sets. -->
  <xs:element name="style">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="name" minOccurs="0"/>
        <xs:element ref="basedOn" minOccurs="0"/>
        <xs:element ref="next" minOccurs="0"/>
        <xs:element ref="uiPriority" minOccurs="0"/>
        <xs:element ref="qFormat" minOccurs="0"/>
        <xs:element ref="pPr" minOccurs="0"/>
        <xs:element ref="rPr" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="styleId" type="xs:string"/>
      <xs:attribute name="default" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="name">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="basedOn">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="next">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="uiPriority">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="qFormat">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>

  <!-- word/fontTable.xml: <w:fonts>. -->
  <xs:element name="fonts">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="font" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="font">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="panose1" minOccurs="0"/>
        <xs:element ref="charset" minOccurs="0"/>
        <xs:element ref="family" minOccurs="0"/>
        <xs:element ref="pitch" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="panose1">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="charset">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="family">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="pitch">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>

  <!-- word/settings.xml: <w:settings>. -->
  <xs:element name="settings">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="zoom" minOccurs="0"/>
        <xs:element ref="proofState" minOccurs="0"/>
        <xs:element ref="defaultTabStop" minOccurs="0"/>
        <xs:element ref="characterSpacingControl" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="zoom">
    <xs:complexType>
      <xs:attribute name="percent" type="xs:string"/>
      <xs:attribute name="val" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="proofState">
    <xs:complexType>
      <xs:attribute name="spelling" type="xs:string"/>
      <xs:attribute name="grammar" type="xs:string"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="defaultTabStop">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="characterSpacingControl">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>

  <!-- word/webSettings.xml: <w:webSettings>. -->
  <xs:element name="webSettings">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="optimizeForBrowser" minOccurs="0"/>
        <xs:element ref="allowPNG" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="optimizeForBrowser">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="allowPNG">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>

  <!-- word/numbering.xml: <w:numbering> — abstract definitions and instances. -->
  <xs:element name="numbering">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="abstractNum" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element ref="num" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="abstractNum">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="multiLevelType" minOccurs="0"/>
        <xs:element ref="lvl" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="abstractNumId" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="multiLevelType">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>

  <xs:element name="lvl">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="start" minOccurs="0"/>
        <xs:element ref="numFmt" minOccurs="0"/>
        <xs:element ref="lvlText" minOccurs="0"/>
        <xs:element ref="lvlJc" minOccurs="0"/>
        <xs:element ref="pPr" minOccurs="0"/>
        <xs:element ref="rPr" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="ilvl" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="start">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="numFmt">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="lvlText">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>
  <xs:element name="lvlJc">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>

  <xs:element name="num">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="abstractNumId" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="numId" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- An element (in <w:num>), distinct from <w:abstractNum>'s attribute of the
       same name — they land on different message types, so both are modeled. -->
  <xs:element name="abstractNumId">
    <xs:complexType><xs:attribute name="val" type="xs:string"/></xs:complexType>
  </xs:element>

  <!-- word/header*.xml and footer*.xml: <w:hdr> / <w:ftr> — block content. -->
  <xs:element name="hdr">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="p"/>
        <xs:element ref="tbl"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <xs:element name="ftr">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="p"/>
        <xs:element ref="tbl"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <!-- word/footnotes.xml / endnotes.xml: each note holds block content. -->
  <xs:element name="footnotes">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="footnote" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="footnote">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="p"/>
        <xs:element ref="tbl"/>
      </xs:choice>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="id" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="endnotes">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="endnote" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="endnote">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element ref="p"/>
        <xs:element ref="tbl"/>
      </xs:choice>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="id" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <!-- word/theme/theme*.xml: <a:theme> (DrawingML) — color and font schemes. -->
  <xs:element name="theme">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="themeElements" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="themeElements">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="clrScheme" minOccurs="0"/>
        <xs:element ref="fontScheme" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="clrScheme">
    <xs:complexType><xs:attribute name="name" type="xs:string"/></xs:complexType>
  </xs:element>

  <xs:element name="fontScheme">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="majorFont" minOccurs="0"/>
        <xs:element ref="minorFont" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="name" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:element name="majorFont">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="latin" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="minorFont">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="latin" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="latin">
    <xs:complexType><xs:attribute name="typeface" type="xs:string"/></xs:complexType>
  </xs:element>

  <!-- docProps/core.xml: <cp:coreProperties> — Dublin Core document metadata.
       Each child is character content (a text leaf). -->
  <xs:element name="coreProperties">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="title" minOccurs="0"/>
        <xs:element ref="subject" minOccurs="0"/>
        <xs:element ref="creator" minOccurs="0"/>
        <xs:element ref="keywords" minOccurs="0"/>
        <xs:element ref="description" minOccurs="0"/>
        <xs:element ref="lastModifiedBy" minOccurs="0"/>
        <xs:element ref="revision" minOccurs="0"/>
